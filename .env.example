# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=safespace_db

# Application Configuration
NODE_ENV=development
PORT=3000

# Security & Privacy (Pepper for one-way anonymized Google Identity hashing)
IDENTITY_PEPPER_SECRET=change_me_to_a_secure_random_string_at_least_32_chars
JWT_SECRET=change_me_to_a_secure_random_jwt_secret_key

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
ALLOWED_EMAIL_DOMAINS=ecampus.ut.ac.id,*

# RBAC Configuration (Pre-approved Sysadmin & Counselor List)
ADMIN_EMAILS=admin@ecampus.ut.ac.id
COUNSELOR_EMAILS=konselor@ecampus.ac.id

# Sandbox & Testing Mode Configuration
ENABLE_SANDBOX=true
SANDBOX_PASSPHRASE=change_me_to_evaluator_passphrase

# Docker Compose Testing Environment
TEST_DB_NAME=safespace_testing_db
TEST_DB_USER=safespace_user
TEST_DB_PASSWORD=safespace_test_pass_secure
TEST_JWT_SECRET=change_me_test_jwt_secret_key
TEST_IDENTITY_PEPPER_SECRET=change_me_test_identity_pepper

# Docker Compose Production Environment
PROD_DB_NAME=safespace_prod_db
PROD_DB_USER=safespace_user
PROD_DB_PASSWORD=change_me_prod_db_password
PROD_JWT_SECRET=change_me_prod_jwt_secret_key
PROD_IDENTITY_PEPPER_SECRET=change_me_prod_identity_pepper
