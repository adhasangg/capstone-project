# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=safespace_db

# Application Configuration
NODE_ENV=development
PORT=3000

# Security & Privacy (Pepper for one-way anonymized Google Identity hashing)
IDENTITY_PEPPER_SECRET=change_me_to_a_secure_random_string_at_least_32_chars
JWT_SECRET=change_me_to_a_secure_random_jwt_secret_key

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
ALLOWED_EMAIL_DOMAINS=ecampus.ut.ac.id,*
