{
  "name": "safespace-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter api --filter web --parallel dev",
    "dev:api": "bun --filter api dev",
    "dev:web": "bun --filter web dev",
    "test": "bun test apps packages",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=.env --filter @safespace/db generate",
    "db:push": "bun --env-file=.env --filter @safespace/db push",
    "db:studio": "bun --env-file=.env --filter @safespace/db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "mermaid": "^12.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.2"
  }
}
